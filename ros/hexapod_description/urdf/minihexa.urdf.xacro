<?xml version="1.0"?>
<!--
  Hiwonder miniHexa. Kinematics identical to firmware/lib/hexa_kin (test/test_urdf_fk.py
  checks the foot positions against it at random joint angles):

    base_link at the body centre, at hip height; x forward, y left, z up.
    <leg>_coxa  revolute about +z at the hip, frame turned to the leg's mount direction
    <leg>_femur revolute about -y (positive lifts the knee), coxa length out
    <leg>_tibia revolute about -y (0 = in line with the femur, negative folds down), femur length out
    <leg>_foot  fixed, tibia length out

  Lengths, hip positions and mount directions are the vendor's design figures
  (docs/hardware-minihexa.md); change them here and in hexa_kin.cpp together, the test
  fails otherwise.
-->
<robot name="minihexa" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="coxa_len" value="0.0285"/>
  <xacro:property name="femur_len" value="0.052"/>
  <xacro:property name="tibia_len" value="0.072"/>
  <xacro:property name="hip_x" value="0.0565"/>
  <xacro:property name="hip_y_corner" value="0.0315"/>
  <xacro:property name="hip_y_mid" value="0.0434"/>
  <xacro:property name="stand_z" value="-0.0600"/>
  <xacro:property name="link_r" value="0.006"/>
  <xacro:property name="body_h" value="0.025"/>

  <material name="body"><color rgba="0.20 0.22 0.25 1"/></material>
  <material name="coxa"><color rgba="0.85 0.45 0.10 1"/></material>
  <material name="femur"><color rgba="0.75 0.75 0.78 1"/></material>
  <material name="tibia"><color rgba="0.30 0.55 0.85 1"/></material>
  <material name="foot"><color rgba="0.10 0.10 0.10 1"/></material>

  <!-- Ground projection of the body centre while standing, for later nav frames. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${-stand_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="0.140 0.087 ${body_h}"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <geometry><box size="0.140 0.087 ${body_h}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="3.1e-4" iyy="4.8e-4" izz="7.7e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- The IMU (QMI8658A on the controller board), at the body centre and nominally level. A
       real board is mounted a little off; the simulated IMU is too (hexa_sensors), and this
       frame does not know it, as with the robot. -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- The ultrasonic at the front of the body, looking forward: hexa_sensors' RangeParams
       (x in base_footprint) is the same mount, checked by test_urdf_fk.py. Placeholder
       until the robot is measured. -->
  <link name="sonar_link"/>
  <joint name="sonar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_link"/>
    <origin xyz="0.080 0 0.020" rpy="0 0 0"/>
  </joint>

  <!-- The camera (hexacam, OV3660), measured on the robot (user, 2026-11-07): 0.065 m ahead of the
       body centre, 0.005 m right of it and 0.11 m above the underside of the body (the box below, 0.025 tall about base_link), looking
       forward. camera_optical_frame is the image's (z forward, x right, y down), the bridge's
       frame_id. -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.065 -0.005 ${0.110 - body_h/2}" rpy="0 0 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- A link drawn as a cylinder along its own +x, `bar_len` long. -->
  <xacro:macro name="bar" params="name bar_len mat mass">
    <link name="${name}">
      <visual>
        <origin xyz="${bar_len/2} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="${link_r}" length="${bar_len}"/></geometry>
        <material name="${mat}"/>
      </visual>
      <collision>
        <origin xyz="${bar_len/2} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="${link_r}" length="${bar_len}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="${bar_len/2} 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="1e-6" iyy="${mass*bar_len*bar_len/12 + 1e-6}" izz="${mass*bar_len*bar_len/12 + 1e-6}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Joint ranges: the servos turn 280 degrees (500-2500 us) centred at coxa 0, femur 0,
       tibia -90 deg (hexa_servo default_cal); the femur is held to +-90 as the vendor does, the
       coxa to +-90 and the tibia to a fold between in line and flat back (the legs meet before
       the servos' ends). Effort and velocity: listed HPD-0127 1.8 kg.cm, 0.05 s/60 deg.
       yaw_deg: the direction the leg points at coxa 0 (corner legs 45 degrees, middle legs out). -->
  <xacro:macro name="leg" params="name x y yaw_deg">
    <xacro:property name="yaw" value="${yaw_deg*pi/180}"/>
    <joint name="${name}_coxa" type="revolute">
      <parent link="base_link"/>
      <child link="${name}_coxa_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 ${yaw}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi/2}" upper="${pi/2}" effort="0.18" velocity="20.9"/>
    </joint>
    <xacro:bar name="${name}_coxa_link" bar_len="${coxa_len}" mat="coxa" mass="0.012"/>

    <joint name="${name}_femur" type="revolute">
      <parent link="${name}_coxa_link"/>
      <child link="${name}_femur_link"/>
      <origin xyz="${coxa_len} 0 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${-pi/2}" upper="${pi/2}" effort="0.18" velocity="20.9"/>
    </joint>
    <xacro:bar name="${name}_femur_link" bar_len="${femur_len}" mat="femur" mass="0.015"/>

    <joint name="${name}_tibia" type="revolute">
      <parent link="${name}_femur_link"/>
      <child link="${name}_tibia_link"/>
      <origin xyz="${femur_len} 0 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${-pi}" upper="0" effort="0.18" velocity="20.9"/>
    </joint>
    <xacro:bar name="${name}_tibia_link" bar_len="${tibia_len}" mat="tibia" mass="0.015"/>

    <joint name="${name}_foot_joint" type="fixed">
      <parent link="${name}_tibia_link"/>
      <child link="${name}_foot"/>
      <origin xyz="${tibia_len} 0 0" rpy="0 0 0"/>
    </joint>
    <link name="${name}_foot">
      <visual>
        <geometry><sphere radius="0.007"/></geometry>
        <material name="foot"/>
      </visual>
    </link>
  </xacro:macro>

  <!-- Order and positions as hexa_kin.cpp: rf rm rr lr lm lf. -->
  <xacro:leg name="rf" x="${hip_x}" y="${-hip_y_corner}" yaw_deg="-45"/>
  <xacro:leg name="rm" x="0.0" y="${-hip_y_mid}" yaw_deg="-90"/>
  <xacro:leg name="rr" x="${-hip_x}" y="${-hip_y_corner}" yaw_deg="-135"/>
  <xacro:leg name="lr" x="${-hip_x}" y="${hip_y_corner}" yaw_deg="135"/>
  <xacro:leg name="lm" x="0.0" y="${hip_y_mid}" yaw_deg="90"/>
  <xacro:leg name="lf" x="${hip_x}" y="${hip_y_corner}" yaw_deg="45"/>

</robot>
